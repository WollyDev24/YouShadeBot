TOKEN=your-bot-token-here
CLIENT_ID=your-application-id-here
GUILD_ID=optional-guild-id-for-quick-registration

# --- AI chat (Gemini) ---
# Key from https://aistudio.google.com/apikey . Without it the /ai command
# and AI chat replies are disabled.
GEMINI_API_KEY=
# Extra keys are optional and use a numeric suffix: GEMINI_API_KEY1,
# GEMINI_API_KEY2, and so on, with no fixed limit. Requests rotate between
# them, and if one is rate limited or rejected the next one is tried, so a
# single bad or exhausted key does not take the AI down. Add as many as you
# like and restart; no code change needed.
# GEMINI_API_KEY1=
# GEMINI_API_KEY2=

# --- Panel ---
PANEL_PASSWORD=admin
PANEL_HOST=0.0.0.0
PANEL_PORT=3000

# Public URL of the panel (used to build Discord OAuth redirect links).
# Leave empty when running locally on http://localhost:PORT.
# PANEL_PUBLIC_URL=https://panel.yourdomain.com

# --- Discord OAuth (optional) ---
# Setting a DISCORD_CLIENT_SECRET enables "Login with Discord" on the panel.
# Without it, access is password-only.
DISCORD_CLIENT_SECRET=
# Bot application ID used for OAuth + "add the bot to your server" links.
# Defaults to the bot's own CLIENT_ID above.
# DISCORD_CLIENT_ID=your-application-id-here

# --- Admin access (optional) ---
# Comma-separated Discord user IDs allowed to manage the bot (register slash
# commands, trigger update checks). Owners/admins get manage rights on servers;
# password logins are always superusers.
# PANEL_ADMIN_USERS=user-id-1,user-id-2

# --- AI Memory ---
# Discord user ID of the bot owner, digits only, e.g. 123456789012345678.
# While this is unset or blank the AI can still read memories, but it is not
# allowed to write, edit or delete any of them, and the owner-only memory
# slash commands reject everyone. The bot warns about this on startup.
OWNER_ID=