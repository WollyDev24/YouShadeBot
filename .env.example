TOKEN=your-bot-token-here
CLIENT_ID=your-application-id-here
GUILD_ID=optional-guild-id-for-quick-registration

# --- Panel ---
PANEL_PASSWORD=admin
PANEL_HOST=0.0.0.0
PANEL_PORT=3000

# Public URL of the panel (used to build Discord OAuth redirect links).
# Leave empty when running locally on http://localhost:PORT.
# PANEL_PUBLIC_URL=https://panel.yourdomain.com

# --- Discord OAuth (optional) ---
# Setting a DISCORD_CLIENT_SECRET enables "Login with Discord" on the panel.
# Without it, access is password-only.
DISCORD_CLIENT_SECRET=
# Bot application ID used for OAuth + "add the bot to your server" links.
# Defaults to the bot's own CLIENT_ID above.
# DISCORD_CLIENT_ID=your-application-id-here

# --- Admin access (optional) ---
# Comma-separated Discord user IDs allowed to manage the bot (register slash
# commands, trigger update checks). Owners/admins get manage rights on servers;
# password logins are always superusers.
# PANEL_ADMIN_USERS=user-id-1,user-id-2